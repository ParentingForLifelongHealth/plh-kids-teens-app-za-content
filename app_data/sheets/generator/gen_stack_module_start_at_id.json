{
  "flow_type": "generator",
  "flow_name": "gen_stack_module_start_at_id",
  "status": "released",
  "parameter_list": {
    "input_data_list": "modules",
    "output_flow_name": "stack_module_{@gen.id}_start_at_id",
    "output_flow_type": "template",
    "output_flow_subtype": "generated"
  },
  "rows": [
    {
      "name": "not_comp_count"
    },
    {
      "name": "module_id",
      "value": "@gen.id"
    },
    {
      "type": "data_items",
      "name": "count_modules",
      "value": "@data.module_tasks",
      "action_list": [
        {
          "trigger": "data_changed",
          "action_id": "set_local",
          "args": [
            "not_comp_count",
            "@items.length"
          ],
          "_raw": "data_changed | set_local: not_comp_count: @items.length"
        }
      ],
      "parameter_list": [
        "filter: (@item.id != @local.module_id) && !@item.completed_ts && (!@item.tag_list || @item.tag_list.includes(@fields.child_age_tag))"
      ],
      "exclude_from_translation": true
    },
    {
      "type": "text",
      "name": "debug_not_comp",
      "value": "not comp: @local.not_comp_count",
      "condition": false,
      "exclude_from_translation": true
    },
    {
      "name": "picked_activity_id"
    },
    {
      "type": "data_items",
      "name": "pick_random_locked_activity",
      "value": "@data.activity_tasks",
      "action_list": [
        {
          "trigger": "data_changed",
          "action_id": "set_local",
          "args": [
            "picked_activity_id",
            "@items[0]?.id"
          ],
          "_raw": "data_changed | set_local: picked_activity_id: @items[0]?.id"
        }
      ],
      "parameter_list": [
        "filter: @item.locked && (@fields.child_age === undefined || !@item.child_age_list || ([].concat(@item.child_age_list)).map(x => String(x)).includes(String(@fields.child_age)))",
        "shuffle",
        "limit: 1"
      ],
      "condition": "!@local.picked_activity_id",
      "exclude_from_translation": true
    },
    {
      "type": "template",
      "name": "module_start_at_id",
      "value": "module_start_at_id_get_unlock",
      "action_list": [
        {
          "trigger": "completed",
          "action_id": "set_data",
          "args": [],
          "_raw": "completed | set_data | _list_id: module_tasks, _id: @gen.id, unlocked_activity: TRUE",
          "params": {
            "_list_id": "module_tasks",
            "_id": "@gen.id",
            "unlocked_activity": true
          }
        },
        {
          "trigger": "completed",
          "action_id": "set_field",
          "args": [
            "latest_unlocked_activity",
            "@local.picked_activity_id"
          ],
          "_raw": "completed | set_field: latest_unlocked_activity: @local.picked_activity_id"
        },
        {
          "trigger": "completed",
          "action_id": "nav_stack",
          "args": [
            "close_top"
          ],
          "_raw": "completed | nav_stack: close_top"
        },
        {
          "trigger": "completed",
          "action_id": "pop_up",
          "args": [
            "unlock_play"
          ],
          "_raw": "completed | pop_up: unlock_play | variant: plh_completion",
          "params": {
            "variant": "plh_completion"
          }
        },
        {
          "trigger": "uncompleted",
          "action_id": "nav_stack",
          "args": [
            "close_top"
          ],
          "_raw": "uncompleted | nav_stack: close_top"
        }
      ],
      "exclude_from_translation": true,
      "rows": [
        {
          "name": "activity_id",
          "value": "@local.picked_activity_id"
        },
        {
          "name": "module_id",
          "value": "@gen.id"
        },
        {
          "name": "unlock_all",
          "value": "@calc(@local.not_comp_count == 0)"
        }
      ]
    }
  ],
  "_source": {

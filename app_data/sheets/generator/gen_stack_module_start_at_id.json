          "action_list": [
            {
              "trigger": "completed",
              "action_id": "set_data",
              "args": [],
              "_raw": "completed | set_data | _list_id: module_tasks, _id: @gen.id, unlocked_activity: TRUE",
              "params": {
                "_list_id": "module_tasks",
                "_id": "@gen.id",
                "unlocked_activity": true
              }
            },
            {
              "trigger": "completed",
              "action_id": "set_field",
              "args": [
                "latest_unlocked_activity",
                "@item.id"
              ],
              "_raw": "completed | set_field: latest_unlocked_activity: @item.id"
            },
            {
              "trigger": "completed",
              "action_id": "nav_stack",
              "args": [
                "close_top"
              ],
              "_raw": "completed | nav_stack: close_top"
            },
            {
              "trigger": "completed",
              "action_id": "pop_up",
              "args": [
                "unlock_play"
              ],
              "_raw": "completed | pop_up: unlock_play | variant: plh_completion",
              "params": {
                "variant": "plh_completion"
              }
            },
            {
              "trigger": "uncompleted",
              "action_id": "nav_stack",
              "args": [
                "close_top"
              ],
              "_raw": "uncompleted | nav_stack: close_top"
            }
          ],
          "rows": [
            {
              "name": "activity_id",
              "value": "@item.id"
            },
            {
              "name": "module_id",
              "value": "@gen.id"
            },
            {
              "name": "course_id",
              "value": "@gen.tag_course"
            },
            {
              "name": "unlock_all",
              "value": "@calc(@local.not_comp_count == 0)"
            }
          ]
        }
      ]
    }
  ],
